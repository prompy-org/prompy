{
  "manifest_version": 3,
  "name": "Prompy",
  "version": "1.0.0",
  "description": "Securely store and manage your prompts",
  "permissions": [
    "storage",
    "identity",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "https://prompy.onrender.com/api/*",
    "https://api.prompy.org/api/*",
    "http://localhost:5000/api/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://api.prompy.org/*", 
      "https://prompy.onrender.com/*", 
      "http://localhost:5000/*"
    ]
  }
}
